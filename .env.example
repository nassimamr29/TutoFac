# Valeurs de démonstration pour le développement local.
# Copier ce fichier : cp .env.example .env (le .env n'est jamais commité)

POSTGRES_DB=tutofac
POSTGRES_USER=tutofac
POSTGRES_PASSWORD=tutofac_dev

# Clé de signature des tokens JWT : 32 caractères minimum, à changer hors démo
JWT_SECRET=dev-only-tutofac-jwt-secret-change-me-0123456789-abcdefghijklmn
# Durée de validité d'un token : 24 h
JWT_EXPIRATION_MS=86400000
